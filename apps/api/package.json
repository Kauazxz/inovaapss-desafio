{
  "name": "@inovaapss/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Express do motor de saude, risco e prioridade de clientes",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "seed:demo": "pnpm -w exec turbo run build --filter=@inovaapss/api... && tsx src/db/seed/demo-auth.ts"
  },
  "dependencies": {
    "@inovaapss/engine": "workspace:*",
    "@inovaapss/shared": "workspace:*",
    "@inovaapss/validation": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mammoth": "1.12.3",
    "multer": "2.4.0",
    "papaparse": "5.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "swagger-ui-express": "^5.0.1",
    "unpdf": "1.8.1",
    "xlsx": "0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inovaapss/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "^22.20.4",
    "@types/papaparse": "5.5.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
