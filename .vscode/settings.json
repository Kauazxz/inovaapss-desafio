{
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.rulers": [
    100
  ],
  "editor.bracketPairColorization.enabled": true,
  "// git": "Puxa o trabalho do grupo automaticamente e sempre com rebase, para nao criar merge sujo na main",
  "git.autofetch": true,
  "git.autofetchPeriod": 60,
  "git.pullBeforeCheckout": true,
  "git.enableSmartCommit": false,
  "git.confirmSync": false,
  "git.branchProtection": [],
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "**/build": true
  },
  "cSpell.language": "en,pt,pt_BR",
  "// liveshare": "Sessao do grupo: quem entra logado no GitHub ja e admitido; convidado pode rodar tasks (Ctrl+Shift+B) e usar o terminal",
  "liveshare.presence": true,
  "liveshare.showInStatusBar": "always",
  "liveshare.focusBehavior": "prompt",
  "liveshare.guestApprovalRequired": false,
  "liveshare.anonymousGuestApproval": "prompt",
  "liveshare.allowGuestTaskControl": true,
  "liveshare.allowGuestDebugControl": true,
  "liveshare.autoShareTerminals": true,
  "liveshare.shareExternalFiles": true,
  "liveshare.excludedFiles": [
    ".env",
    ".env.*",
    "!.env.example"
  ]
}
