{
  "name": "@inovaapss/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Schemas Zod compartilhados entre API e web (paginacao, ids, variaveis de ambiente)",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@inovaapss/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inovaapss/config": "workspace:*",
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
