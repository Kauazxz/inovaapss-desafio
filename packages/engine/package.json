{
  "name": "@inovaapss/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motor puro de scoring (saude, tendencia, persistencia, risco, prioridade, forecast) e de SLA - sem banco, sem HTTP",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inovaapss/shared": "workspace:*",
    "json-logic-js": "^2.0.5"
  },
  "devDependencies": {
    "@inovaapss/config": "workspace:*",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
