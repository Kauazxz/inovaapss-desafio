{
  "$schema": "https://json.schemastore.org/tsconfig",
  "// leia-me": "apps/web (Vite + React). O Vite faz o bundle; o tsc so confere tipos (noEmit).",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
