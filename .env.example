# Copie este arquivo para .env e preencha com os dados do seu projeto no Supabase.
# Onde achar: painel do Supabase -> Project Settings -> API
#
# O .env NUNCA vai para o GitHub (esta no .gitignore). Este .env.example vai.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
