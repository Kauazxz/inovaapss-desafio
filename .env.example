# Copie este arquivo para .env (na raiz do repositorio) e preencha com os dados do
# seu projeto no Supabase. Deixe aqui apenas placeholders.
#
# O .env NUNCA vai para o GitHub (esta no .gitignore). Este .env.example vai.
# A API (apps/api) le as variaveis sem prefixo; o front (apps/web) so enxerga as VITE_*.

# ---------- Ambiente ----------
# development | test | production
NODE_ENV=development
# Porta da API em desenvolvimento (o front chama http://localhost:3001)
PORT=3001
# Origens permitidas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5173

# ---------- Supabase (API) ----------
# Nesta etapa a API sobe sem nada disto (o /ready responde "db: not_configured").
# Deixe VAZIO ate ter o valor real: um placeholder preenchido e tratado como valor valido
# e faz o /ready responder 503 tentando conectar num endereco que nao existe.
# Painel do Supabase -> Project Settings -> API -> Project URL
#   formato: https://<id-do-projeto>.supabase.co
SUPABASE_URL=
# Painel do Supabase -> Project Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=
# Painel do Supabase -> Project Settings -> API -> Project API keys -> service_role
# SOMENTE no backend. Nunca no front, nunca em arquivo versionado.
SUPABASE_SERVICE_ROLE_KEY=
# Painel do Supabase -> botao "Connect" (topo) ou Database -> Connection string,
# modo "Transaction pooler" (porta 6543), trocando [YOUR-PASSWORD] pela senha do banco.
#   formato: postgresql://postgres.<id-do-projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------- Supabase (front, apps/web) ----------
# Mesmos valores de SUPABASE_URL e SUPABASE_ANON_KEY (a chave anon pode ir ao navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
# Endereco da API que o front chama
VITE_API_URL=http://localhost:3001

# ---------- Opcionais ----------
# IA para revisao de documentos (fica para depois - ajuste A5). Vazio = modo manual.
ANTHROPIC_API_KEY=
# Monitoramento de erros (opcional). Vazio = desligado.
SENTRY_DSN=

# ---------- Seed de demonstracao (so no shell, nunca preencha aqui) ----------
# pnpm --filter @inovaapss/api seed:demo cria a organizacao "GlobalSys (demo)" e o usuario owner.
# Exporte as duas variaveis no terminal na hora de rodar (docs/AUTH.md, secao 5).
# SEED_DEMO_EMAIL=demo@exemplo.com
# SEED_DEMO_PASSWORD=uma-senha-forte-12+
